`timescale 1ns / 1ps

module tb_riscv_alu_control;

reg  [31:0] instruction;
reg  [31:0] A;
reg  [31:0] B;

wire [31:0] Result;
wire Zero;
wire LessThan;


//============================================================
// DUT
//============================================================

riscv_alu_control_top DUT (

    .instruction(instruction),
    .A(A),
    .B(B),
    .Result(Result),
    .Zero(Zero),
    .LessThan(LessThan)

);


//============================================================
// Test
//============================================================

initial begin

    $display("==============================================");
    $display("       RISC-V ALU TESTBENCH");
    $display("==============================================");


    // -------------------------------------------------------
    // ADD
    // -------------------------------------------------------

    A = 32'd10;
    B = 32'd20;

    // ADD x1,x2,x3
    // funct7 = 0000000
    // funct3 = 000
    // opcode = 0110011

    instruction = 32'b0000000_00000_00000_000_00000_0110011;

    #10;

    $display("ADD : A=%d B=%d Result=%d", A, B, Result);


    // -------------------------------------------------------
    // SUB
    // -------------------------------------------------------

    A = 32'd30;
    B = 32'd10;

    instruction = 32'b0100000_00000_00000_000_00000_0110011;

    #10;

    $display("SUB : A=%d B=%d Result=%d", A, B, Result);


    // -------------------------------------------------------
    // AND
    // -------------------------------------------------------

    A = 32'hFF00FF00;
    B = 32'h0F0F0F0F;

    instruction = 32'b0000000_00000_00000_111_00000_0110011;

    #10;

    $display("AND : Result=%h", Result);


    // -------------------------------------------------------
    // OR
    // -------------------------------------------------------

    A = 32'hFF00FF00;
    B = 32'h0F0F0F0F;

    instruction = 32'b0000000_00000_00000_110_00000_0110011;

    #10;

    $display("OR  : Result=%h", Result);


    // -------------------------------------------------------
    // XOR
    // -------------------------------------------------------

    A = 32'hAAAA5555;
    B = 32'hFFFF0000;

    instruction = 32'b0000000_00000_00000_100_00000_0110011;

    #10;

    $display("XOR : Result=%h", Result);


    // -------------------------------------------------------
    // SLL
    // -------------------------------------------------------

    A = 32'd1;
    B = 32'd4;

    instruction = 32'b0000000_00000_00000_001_00000_0110011;

    #10;

    $display("SLL : Result=%d", Result);


    // -------------------------------------------------------
    // SRL
    // -------------------------------------------------------

    A = 32'h00000080;
    B = 32'd3;

    instruction = 32'b0000000_00000_00000_101_00000_0110011;

    #10;

    $display("SRL : Result=%h", Result);


    // -------------------------------------------------------
    // SRA
    // -------------------------------------------------------

    A = 32'h80000000;
    B = 32'd4;

    instruction = 32'b0100000_00000_00000_101_00000_0110011;

    #10;

    $display("SRA : Result=%h", Result);


    // -------------------------------------------------------
    // SLT
    // -------------------------------------------------------

    A = 32'd10;
    B = 32'd20;

    instruction = 32'b0000000_00000_00000_010_00000_0110011;

    #10;

    $display("SLT : Result=%d", Result);


    // -------------------------------------------------------
    // SLTU
    // -------------------------------------------------------

    A = 32'd10;
    B = 32'd20;

    instruction = 32'b0000000_00000_00000_011_00000_0110011;

    #10;

    $display("SLTU: Result=%d", Result);


    // -------------------------------------------------------
    // ZERO FLAG
    // -------------------------------------------------------

    A = 32'd10;
    B = 32'd10;

    instruction = 32'b0100000_00000_00000_000_00000_0110011;

    #10;

    $display("ZERO FLAG: Result=%d Zero=%b", Result, Zero);


    $display("==============================================");
    $display("             TEST COMPLETE");
    $display("==============================================");

    #10;

    $finish;

end

endmodule
